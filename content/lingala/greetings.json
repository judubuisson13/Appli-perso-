      "id": "ln-d1",
      "title": "Rencontre dans la rue",
      "status": "to-verify",
      "lines": [
        {
          "speaker": "A",
          "ln": "Mbote!",
          "fr": "Salut !"
        },
        {
          "speaker": "B",
          "ln": "Mbote na yo.",
          "fr": "Salut à toi."
        },
        {
          "speaker": "A",
          "ln": "Sango nini?",
          "fr": "Quoi de neuf ?"
        },
        {
          "speaker": "B",
          "ln": "Sango te. Yo, ozali malamu?",
          "fr": "Rien de spécial. Et toi, tu vas bien ?"
        },
        {
          "speaker": "A",
          "ln": "Ee, nazali malamu. Matondo.",
          "fr": "Oui, je vais bien. Merci."
        },
        {
          "speaker": "B",
          "ln": "Tikala malamu!",
          "fr": "Au revoir ! (B s'en va)"
        },
        {
          "speaker": "A",
          "ln": "Kende malamu. Tokomonana!",
          "fr": "Au revoir. À plus tard !"
        }
      ]
    }

    {
      "id": "dal",
      "title": "Dal de lentilles corail au lait de coco",
      "servings": 4,
      "minutes": 30,
      "kidFriendly": true,
      "tags": [
        "végétarien",
        "batch"
      ],
      "ingredients": [
        {
          "ing": "lentilles-corail",
          "qty": 300

        {
          "ing": "sel",
          "qty": 1
        },
        {
          "ing": "riz",
          "qty": 250
        }
      ],
      "steps": [
        "Émince l’oignon et l’ail, fais-les revenir 3 min dans l’huile.",
        "Ajoute le curry, puis les lentilles rincées, les tomates et le lait de coco.",
        "Laisse mijoter 20 min en remuant, ajoute un peu d’eau si besoin.",
        "Sers avec le riz. Pour l’enfant : moins de curry, ou curry doux."
      ]
    },
